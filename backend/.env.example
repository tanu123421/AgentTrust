# AgentTrust Environment Configuration
PROJECT_NAME="AgentTrust"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (SQLite local persistence)
DATABASE_URL="sqlite:///./agent_trust.db"

# CORS configuration (comma-separated allowed origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Optional AI Provider (offline by default, no key required)
LLM_PROVIDER="offline"
LLM_API_KEY=""
LLM_MODEL="synthetic-evaluator-v1"

# Evaluation Execution Limits
MAX_TEST_CASES_PER_RUN=100
MAX_INPUT_LENGTH_CHARS=20000
TEST_TIMEOUT_SECONDS=30
